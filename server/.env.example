# ------------------------------------------------------------------
# ACP Backend environment variables
# Copy this file to `.env` and fill in real values.
# ------------------------------------------------------------------

# Server
# Locally any port works. On Render/hosting do NOT set this: the platform
# injects PORT and the server reads it.
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
# Atlas dashboard -> Connect -> Drivers -> copy the string
#
# IMPORTANT: the host running the server must be allowed in Atlas.
# Atlas -> Network Access -> IP Access List
#   - local dev: add your current public IP (changes when your ISP/mobile hotspot does)
#   - Render free plan: add 0.0.0.0/0
# Otherwise you get "Could not connect to any servers in your MongoDB Atlas cluster".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/acp_app?retryWrites=true&w=majority

# JWT signing secret - use a long random string
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Bootstrap admin account (used by `npm run seed`).
# ADMIN_RESET_PASSWORD=true also overwrites the password of an existing admin
# (handy when you are locked out) - otherwise it is left untouched.
ADMIN_NAME=ACP Admin
ADMIN_EMAIL=admin@acp.com
ADMIN_PASSWORD=Admin@123
ADMIN_RESET_PASSWORD=false

# Company support number shown in the customer app
SUPPORT_PHONE=+971501234567

# Comma separated list of allowed CORS origins, * allows all
CORS_ORIGIN=*

# Google OAuth *Web* client ID - must match EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID
# in app/.env, otherwise /api/auth/google rejects the ID token.
GOOGLE_CLIENT_ID=<something>.apps.googleusercontent.com
