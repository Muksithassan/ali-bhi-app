# Copy this file to `.env` and fill in real values.
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app bundle.
#
# For a local dev server, use your PC's LAN IP (find it with `ipconfig`),
# e.g. http://192.168.1.10:5000/api
# For a deployed server, use its public URL, e.g. https://acp-api.onrender.com/api
EXPO_PUBLIC_API_URL=http://192.168.1.10:5000/api

# Google OAuth *Web* client ID (must match GOOGLE_CLIENT_ID on the server).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=245458778051-23rdejm0b384kgqhj7dk392hkeasdfp6.apps.googleusercontent.com
